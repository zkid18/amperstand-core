{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Amperstand",
  "description": "Save articles, videos, newsletters and posts as markdown files you own, on a server you run. Search them yourself or from your AI agents.",
  "colors": {
    "primary": "#0F172A",
    "light": "#3B82F6",
    "dark": "#0F172A"
  },
  "favicon": "/images/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "introduction",
              "concepts"
            ]
          },
          {
            "group": "Run a server",
            "pages": [
              "quickstart",
              "server-install-docker",
              "configuration",
              "deployment",
              "api-key"
            ]
          },
          {
            "group": "Command-line tools",
            "pages": [
              "cli-install",
              "cli-quickstart",
              "cli-reference",
              "admin-cli",
              "vault-sync-local"
            ]
          },
          {
            "group": "Build with AI agents",
            "pages": [
              "agents-overview",
              "agent-mini-skill",
              "agent-shell",
              "agent-skill",
              "agent-prompt",
              "agent-credentials-gateway"
            ]
          },
          {
            "group": "Build a custom client",
            "pages": [
              "examples/build-your-own",
              "examples/telegram-bot",
              "examples/browser-extension"
            ]
          },
          {
            "group": "HTTP API reference",
            "pages": [
              "api-reference/overview",
              "api-reference/authentication",
              "api-reference/curl-cookbook",
              "api-reference/capture",
              "api-reference/jobs",
              "api-reference/vault-docs",
              "api-reference/vault-search",
              "api-reference/feeds"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/zkid18/amperstand-core",
          "icon": "github"
        },
        {
          "anchor": "PyPI",
          "href": "https://pypi.org/project/amperstand/",
          "icon": "python"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/logo.svg",
    "dark": "/images/logo-dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/zkid18/amperstand-core"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/zkid18"
    }
  }
}
